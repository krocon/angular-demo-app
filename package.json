{
  "name": "angular22-video-demos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "snippets": "node scripts/generate-sources.mjs",
    "prestart": "npm run snippets",
    "start": "ng serve",
    "prebuild": "npm run snippets",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run snippets",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:coverage": "npm run snippets && ng test --no-watch --coverage",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"scripts/**/*.mjs\"",
    "analyze": "npm run snippets && ng build --stats-json && node -e \"console.log('\\nUpload dist/angular22-video-demos/stats.json to https://esbuild.github.io/analyze/')\"",
    "analyze:sme": "npm run snippets && ng build --source-map && source-map-explorer \"dist/angular22-video-demos/browser/*.js\" --no-border-checks",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@guiexpert/angular-table": "^22.1.84",
    "@guiexpert/table": "^1.1.84",
    "material-symbols": "^0.47.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
